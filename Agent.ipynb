# 🔁 Allow nested asyncio loops (needed for Colab/Jupyter)
import nest_asyncio
nest_asyncio.apply()

# 🧠 Async and AutoGen imports
import asyncio
from autogen_agentchat.agents import AssistantAgent
from autogen_agentchat.conditions import TextMentionTermination
from autogen_agentchat.teams import RoundRobinGroupChat
from autogen_agentchat.ui import Console

# 🧠 Groq model client for LLM interaction
from autogen_ext.models.openai import OpenAIChatCompletionClient

# 🔐 Get the Groq API key securely from Google Colab's userdata
from google.colab import userdata
groq_api_key = userdata.get("GROQ_API_KEY")

# 🧠 Initialize the model client with Groq API key
model_client = OpenAIChatCompletionClient(api_key=groq_api_key, base_url="https://api.groq.com/openai/v1")

# 🧳 Define four assistant agents with different roles

# Agent 1: Plans the overall travel itinerary
planner_agent = AssistantAgent(
    "planner_agent",
    model_client=model_client,
    description="A helpful assistant that can plan trips.",
    system_message="You are a helpful assistant that can suggest a travel plan for a user based on their request.",
)

# Agent 2: Suggests local activities and places to visit
local_agent = AssistantAgent(
    "local_agent",
    model_client=model_client,
    description="A local assistant that can suggest local activities or places to visit.",
    system_message="You are a helpful assistant that can suggest authentic and interesting local activities or places to visit for a user and can utilize any context information provided.",
)

# Agent 3: Provides tips on language and communication for the destination
language_agent = AssistantAgent(
    "language_agent",
    model_client=model_client,
    description="A helpful assistant that can provide language tips for a given destination.",
    system_message="You are a helpful assistant that can review travel plans, providing feedback on important/critical tips about how best to address language or communication challenges for the given destination. If the plan already includes language tips, you can mention that the plan is satisfactory, with rationale.",
)

# Agent 4: Summarizes and finalizes the travel plan
travel_summary_agent = AssistantAgent(
    "travel_summary_agent",
    model_client=model_client,
    description="A helpful assistant that can summarize the travel plan.",
    system_message="You are a helpful assistant that can take in all of the suggestions and advice from the other agents and provide a detailed final travel plan. YOU MUST RETURN A COMPLETE PLAN. End your final response with TERMINATE.",
)

# 🛑 Define when to stop: when someone says "TERMINATE"
termination = TextMentionTermination("TERMINATE")

# 🧠 Set up a group chat using Round Robin coordination
group_chat = RoundRobinGroupChat(
    [planner_agent, local_agent, language_agent, travel_summary_agent],
    termination_condition=termination
)

# 🚀 Define and run the main execution loop
async def run_travel_planner():
    # Run the agent conversation starting with the task
    await Console(group_chat.run_stream(task="Plan trip to GOA"))
    await model_client.close()  # Close client cleanly

# 🏁 Start the async travel planner
await run_travel_planner()
